// ============================================================
// LocaBénin — Schéma de données
// SQLite local (sandbox) — migration PostgreSQL/Supabase en production.
// Conventions :
//  - Montants en FCFA : TOUJOURS des entiers (Int), jamais de flottants.
//  - SQLite ne supporte pas les enums Prisma ni Json :
//    les énumérations métier sont des String validées par Zod côté serveur
//    (constantes centralisées dans src/lib/constants.ts).
//  - Soft delete (deletedAt) sur les données utilisateur importantes.
//  - Le contrôle d'accès fin (IDOR) est appliqué dans les routes API :
//    voir docs/DATABASE.md pour la correspondance RLS Supabase prévue.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Utilisateurs, rôles, identité ----------

model User {
  id            String    @id @default(cuid())
  phone         String?   @unique
  email         String?   @unique
  passwordHash  String?
  fullName      String
  avatarUrl     String?
  whatsapp      String?
  status        String    @default("ACTIVE") // ACTIVE | SUSPENDED | BANNED | DELETED
  kycStatus     String    @default("NONE") // NONE | PENDING | VERIFIED | REJECTED
  phoneVerified Boolean   @default(false)
  emailVerified Boolean   @default(false)
  language      String    @default("fr") // i18n-ready
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  userRoles     UserRole[]
  kycDocuments  KycDocument[]
  listings      Listing[]
  properties    Property[]
  leasesAsOwner Lease[]         @relation("LeaseOwner")
  leasesAsTenant Lease[]        @relation("LeaseTenant")
  payments      Payment[]       @relation("PaymentPayer")
  favorites     Favorite[]
  savedSearches SavedSearch[]
  visitsRequested Visit[]       @relation("VisitTenant")
  visitsHosted  Visit[]         @relation("VisitOwner")
  applications  Application[]
  reviews       Review[]
  reportsFiled  Report[]        @relation("ReportReporter")
  notifications Notification[]
  ticketsCreated MaintenanceTicket[] @relation("TicketTenant")
  messages      Message[]
  announcements Announcement[]
  affiliateLinks AffiliateLink[]
  commissions   Commission[]
  payouts       Payout[]
  auditLogs     AuditLog[]
  pushSubscriptions PushSubscription[]
  conversations ConversationParticipant[]
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  role         String // OWNER | TENANT | AGENT | ADMIN
  adminSubRole String? // SUPER_ADMIN | MODERATOR | SUPPORT | ACCOUNTANT (si role=ADMIN)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model KycDocument {
  id              String    @id @default(cuid())
  userId          String
  kind            String // ID_CARD | PASSPORT | DRIVER_LICENSE | SELFIE
  fileUrl         String
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model OtpCode {
  id          String    @id @default(cuid())
  destination String // téléphone ou email
  codeHash    String
  purpose     String    @default("AUTH") // AUTH | PAYOUT | SENSITIVE
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([destination, purpose])
}

// ---------- Géographie du Bénin ----------

model Department {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String
  communes Commune[]
}

model Commune {
  id           String  @id @default(cuid())
  departmentId String
  name         String
  department   Department @relation(fields: [departmentId], references: [id])
  areas        Area[]

  @@unique([departmentId, name])
  @@index([name])
}

model Area {
  id        String  @id @default(cuid())
  communeId String
  name      String
  kind      String  @default("QUARTIER") // ARRONDISSEMENT | QUARTIER
  commune   Commune @relation(fields: [communeId], references: [id])
  listings  Listing[]

  @@unique([communeId, name])
  @@index([name])
}

// ---------- Biens et offres ----------

// Immeuble / propriété regroupant plusieurs unités (optionnel)
model Property {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  addressText String?
  areaId      String?
  description String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  owner    User     @relation(fields: [ownerId], references: [id])
  listings Listing[]

  @@index([ownerId])
}

model Listing {
  id            String    @id @default(cuid())
  reference     String    @unique // LB-XXXXXX
  ownerId       String
  propertyId    String?
  title         String
  description   String
  type          String // APARTMENT | HOUSE | VILLA | OFFICE | GARAGE | LAND | FIELD | ESTATE | SHOP
  genre         String // SIMPLE | FURNISHED
  category      String // EMPTY_HOUSING | FURNISHED | OFFICE  (dérivé du type+genre, sert aux abonnements)
  status        String    @default("DRAFT") // DRAFT | PENDING_REVIEW | PUBLISHED | RESERVED | RENTED | SUSPENDED_OWNER | SUSPENDED_UNPAID | ARCHIVED
  bedrooms      Int       @default(0) // 0 = studio ; -1 = chambre-salon
  bathrooms     Int       @default(0) // douches
  livingRooms   Int       @default(0)
  surfaceM2     Int?
  addressText   String?
  areaId        String?
  latitude      Float?
  longitude     Float?
  // Tarification (FCFA entiers)
  rentAmount    Int       @default(0) // prix de base
  rentPeriod    String    @default("MONTH") // DAY | WEEK | MONTH | QUARTER | SEMESTER | LEASE
  depositAmount Int       @default(0) // caution (location simple uniquement)
  advanceMonths Int       @default(0) // mois d'avance (location simple)
  dailyPrice    Int? // meublé : prix / jour
  weeklyPrice   Int? // meublé : prix / semaine
  monthlyPrice  Int? // meublé : prix / mois
  minStayDays   Int? // meublé : durée minimale
  allowPartial  Boolean   @default(false) // paiement partiel du loyer autorisé
  rulesText     String?
  affiliateEnabled Boolean @default(false) // option Démarcheur
  visitsCount   Int       @default(0)
  favoritesCount Int      @default(0)
  isFeatured    Boolean   @default(false)
  moderationNote String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  owner     User     @relation(fields: [ownerId], references: [id])
  property  Property? @relation(fields: [propertyId], references: [id])
  area      Area?    @relation(fields: [areaId], references: [id])
  media     ListingMedia[]
  depositOptions DepositOption[]
  amenities ListingAmenity[]
  calendarBlocks CalendarBlock[]
  bookings  Booking[]
  visits    Visit[]
  applications Application[]
  leases    Lease[]
  affiliateLinks AffiliateLink[]
  favorites Favorite[]
  reviews   Review[]
  commissions Commission[]
  reports   Report[]

  @@index([status, genre])
  @@index([status, type])
  @@index([category, status])
  @@index([rentAmount])
  @@index([areaId])
  @@index([ownerId])
  @@index([isFeatured, status])
}

model ListingMedia {
  id        String  @id @default(cuid())
  listingId String
  kind      String  @default("IMAGE") // IMAGE | VIDEO
  url       String
  thumbUrl  String?
  position  Int     @default(0)
  isCover   Boolean @default(false)
  width     Int?
  height    Int?
  sizeBytes Int?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

// Cautions optionnelles fixes (eau, électricité, autres libellés libres)
model DepositOption {
  id        String @id @default(cuid())
  listingId String
  label     String
  amount    Int

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Amenity {
  id    String @id @default(cuid())
  code  String @unique
  label String
  icon  String
  group String @default("CONFORT") // CONFORT | SECURITE | EXTERIEUR | SERVICES

  listings ListingAmenity[]
}

model ListingAmenity {
  listingId String
  amenityId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
}

// Dates bloquées (calendrier de disponibilité des meublés)
model CalendarBlock {
  id        String   @id @default(cuid())
  listingId String
  startDate DateTime
  endDate   DateTime
  reason    String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate])
}

// ---------- Recherche, favoris, visites, candidatures ----------

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId])
}

model SavedSearch {
  id            String    @id @default(cuid())
  userId        String
  name          String
  filtersJson   String
  alertsEnabled Boolean   @default(true)
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Visit {
  id          String   @id @default(cuid())
  listingId   String
  tenantId    String
  ownerId     String
  scheduledAt DateTime
  status      String   @default("REQUESTED") // REQUESTED | CONFIRMED | REJECTED | CANCELLED | DONE
  note        String?
  createdAt   DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant  User    @relation("VisitTenant", fields: [tenantId], references: [id])
  owner   User    @relation("VisitOwner", fields: [ownerId], references: [id])

  @@index([listingId])
  @@index([tenantId])
  @@index([ownerId, scheduledAt])
}

model Application {
  id          String    @id @default(cuid())
  listingId   String
  tenantId    String
  message     String?
  status      String    @default("PENDING") // PENDING | ACCEPTED | REJECTED | WITHDRAWN
  affiliateLinkId String? // attribution au moment de la candidature
  visitorId   String?
  leaseId     String?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant  User    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([tenantId])
}

// ---------- Baux, loyers, réservations ----------

model Lease {
  id          String    @id @default(cuid())
  reference   String    @unique // BAIL-XXXXXX
  listingId   String
  ownerId     String
  tenantId    String
  kind        String    @default("SIMPLE") // SIMPLE | FURNISHED
  bookingId   String? @unique
  startDate   DateTime
  endDate     DateTime?
  rentAmount  Int
  rentPeriod  String
  depositAmount    Int  @default(0)
  advanceMonths    Int  @default(0)
  advancePaidAmount Int @default(0)
  depositOptionsJson String? // snapshot [{label, amount}]
  // Option démarcheur (snapshot au moment de la signature)
  affiliateLinkId     String?
  commissionTotal     Int     @default(0)
  commissionTenantShare Int   @default(0)
  commissionOwnerShare Int    @default(0)
  status      String    @default("ACTIVE") // ACTIVE | NOTICE_GIVEN | TERMINATED | EXPIRED
  noticeDate  DateTime?
  allowPartial Boolean  @default(false)
  contractPdfUrl  String?
  contractHash    String?
  ownerSignatureUrl  String?
  ownerSignedAt      DateTime?
  tenantSignatureUrl String?
  tenantSignedAt     DateTime?
  inventoryInUrl  String?
  inventoryOutUrl String?
  depositReturnedAmount Int     @default(0)
  depositReturnedAt     DateTime?
  createdAt   DateTime  @default(now())

  listing Listing @relation(fields: [listingId], references: [id])
  owner   User    @relation("LeaseOwner", fields: [ownerId], references: [id])
  tenant  User    @relation("LeaseTenant", fields: [tenantId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  payments Payment[]
  schedules RentSchedule[]
  tickets MaintenanceTicket[]
  reviews Review[]
  commissions Commission[]

  @@index([ownerId, status])
  @@index([tenantId, status])
  @@index([listingId])
}

model RentSchedule {
  id         String    @id @default(cuid())
  leaseId    String
  dueDate    DateTime
  amount     Int
  paidAmount Int       @default(0)
  status     String    @default("PENDING") // PENDING | PARTIAL | PAID | LATE | WAIVED
  paidAt     DateTime?
  paymentId  String?
  quittanceUrl String?

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([leaseId, dueDate])
  @@index([status])
}

// Réservation de meublé courte durée
model Booking {
  id         String   @id @default(cuid())
  code       String   @unique // RES-XXXXXX
  listingId  String
  tenantId   String
  startDate  DateTime
  endDate    DateTime
  guests     Int      @default(1)
  nights     Int
  totalAmount Int
  status     String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | CONFIRMED | CANCELLED | COMPLETED
  createdAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  lease   Lease?
  payments Payment[]

  @@index([listingId, startDate])
  @@index([tenantId])
}

// ---------- Paiements, ledger, retraits ----------

model Payment {
  id         String    @id @default(cuid())
  reference  String    @unique // PAY-XXXXXX
  payerId    String
  purpose    String // INITIAL | RENT | BOOKING | SUBSCRIPTION | DEPOSIT_RETURN
  amount     Int
  method     String // MTN_MOMO | MOOV_MONEY | CELTIS_CASH | CARD
  status     String    @default("INITIATED") // INITIATED | PENDING | SUCCESS | FAILED | REFUNDED | DISPUTED | CANCELLED
  provider   String    @default("mock") // mock | fedapay | kkiapay
  providerRef String?  @unique
  leaseId    String?
  bookingId  String?
  invoiceId  String?
  scheduleId String?
  breakdownJson String? // [{label, amount}] détail du paiement initial
  failureReason String?
  refundedAmount Int    @default(0)
  createdAt  DateTime  @default(now())
  confirmedAt DateTime?

  payer    User   @relation("PaymentPayer", fields: [payerId], references: [id])
  lease    Lease? @relation(fields: [leaseId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@index([payerId])
  @@index([status])
  @@index([leaseId])
}

// Événements de webhook : idempotence stricte (un eventId ne passe qu'une fois)
model PaymentEvent {
  id             String    @id @default(cuid())
  provider       String
  eventId        String    @unique
  type           String
  payloadJson    String
  signatureValid Boolean   @default(false)
  processingError String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([provider, processedAt])
}

// Comptes du ledger en partie double. Soldes DÉRIVÉS des écritures (aucun champ solde).
// kinds : ASSET_CASH (encaissements plateforme) | ASSET_PAYOUTS (sorties)
//         LIABILITY_WALLET (dû à un propriétaire/démarcheur) | LIABILITY_ESCROW (séquestre)
//         REVENUE (abonnements plateforme) | EXPENSE
model LedgerAccount {
  id        String  @id @default(cuid())
  code      String  @unique // ex. WALLET:OWNER:cuid | WALLET:AGENT:cuid | PLATFORM:CASH | PLATFORM:REVENUE | ESCROW:TENANT:cuid
  kind      String
  ownerType String // PLATFORM | OWNER | AGENT | TENANT
  ownerId   String?
  label     String
  createdAt DateTime @default(now())

  entries LedgerEntry[]

  @@index([ownerType, ownerId])
}

// Écritures immuables — une transaction = ensemble équilibré DEBIT/CREDIT (somme égale)
model LedgerEntry {
  id            String   @id @default(cuid())
  accountId     String
  direction     String // DEBIT | CREDIT
  amount        Int
  memo          String
  paymentId     String?
  commissionId  String?
  payoutId      String?
  idempotencyKey String  @unique
  createdAt     DateTime @default(now())

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([paymentId])
}

model Payout {
  id             String    @id @default(cuid())
  userId         String
  userRole       String // OWNER | AGENT
  amount         Int
  method         String // MTN_MOMO | MOOV_MONEY | CELTIS_CASH
  destination    String // numéro Mobile Money
  status         String    @default("OTP_PENDING") // OTP_PENDING | REQUESTED | APPROVED | PROCESSING | PAID | REJECTED
  otpVerified    Boolean   @default(false)
  reviewedById   String?
  reviewedAt     DateTime?
  rejectionReason String?
  providerRef    String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// ---------- Abonnements propriétaires ----------

// Tarifs par catégorie, modifiables dans le back-office (paramétrage sans code)
model CategoryPricing {
  category     String   @id // EMPTY_HOUSING | FURNISHED | OFFICE
  monthlyPrice Int
  label        String
  updatedAt    DateTime @updatedAt
}

// Facture mensuelle d'abonnement, une par propriétaire et par période
model SubscriptionInvoice {
  id             String    @id @default(cuid())
  ownerId        String
  periodStart    DateTime
  periodEnd      DateTime
  amount         Int
  lineItemsJson  String // [{category, label, price, listingCount}]
  status         String    @default("DUE") // DUE | PAID | OVERDUE | CANCELLED
  dueDate        DateTime
  graceUntil     DateTime
  paidAt         DateTime?
  paymentId      String?
  remindersSentJson String @default("[]")
  createdAt      DateTime  @default(now())

  @@unique([ownerId, periodStart])
  @@index([ownerId, status])
}

// ---------- Option Démarcheur (affiliation) ----------

model AffiliateLink {
  id        String   @id @default(cuid())
  code      String   @unique // code court pour l'URL ?ref=
  listingId String
  agentId   String
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  agent   User     @relation(fields: [agentId], references: [id])
  clicksList AffiliateClick[]
  attributions AffiliateAttribution[]
  commissions Commission[]

  @@unique([listingId, agentId])
  @@index([agentId])
}

model AffiliateClick {
  id        String   @id @default(cuid())
  linkId    String
  visitorId String // cookie visiteur (30 j par défaut, dernier clic prime)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  link AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([visitorId])
}

// Attribution courante par visiteur — dernier clic prime (paramétrable)
model AffiliateAttribution {
  id         String   @id @default(cuid())
  visitorId  String   @unique
  linkId     String
  agentId    String
  listingId  String
  lastClickAt DateTime @default(now())
  expiresAt  DateTime

  link AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
}

model Commission {
  id           String    @id @default(cuid())
  agentId      String
  listingId    String
  leaseId      String?
  bookingId    String?
  paymentId    String
  linkId       String?
  tenantShare  Int // part locataire (25 % d'un mois)
  ownerShare   Int // part propriétaire (25 % d'un mois)
  total        Int // 50 % d'un mois
  status       String    @default("PENDING_VALIDATION") // PENDING_VALIDATION | VALIDATED | PAID | CANCELLED
  validatableAt DateTime // fin de la période de validation anti-fraude
  validatedAt  DateTime?
  paidAt       DateTime?
  fraudFlag    String?
  createdAt    DateTime  @default(now())

  agent   User    @relation(fields: [agentId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
  link    AffiliateLink? @relation(fields: [linkId], references: [id])
  lease   Lease?  @relation(fields: [leaseId], references: [id])

  @@index([agentId, status])
  @@index([paymentId])
}

// ---------- Communication ----------

model Conversation {
  id            String    @id @default(cuid())
  listingId     String?
  leaseId       String?
  subject       String?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Announcement {
  id            String   @id @default(cuid())
  ownerId       String
  scope         String   @default("ALL") // ALL | PROPERTY | LISTING
  scopeId       String?
  title         String
  body          String
  channelsJson  String   @default("[\"IN_APP\"]") // IN_APP | SMS | WHATSAPP
  recipientCount Int     @default(0)
  createdAt     DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // RENT_DUE | RENT_LATE | MESSAGE | VISIT | APPLICATION | PAYMENT | SUBSCRIPTION | COMMISSION | KYC | SYSTEM | TICKET
  title     String
  body      String
  linkHash  String?
  dataJson  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keysJson  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Réparations, avis, signalements ----------

model MaintenanceTicket {
  id          String    @id @default(cuid())
  leaseId     String
  tenantId    String
  ownerId     String
  listingId   String
  title       String
  description String
  photosJson  String    @default("[]")
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  priority    String    @default("NORMAL") // LOW | NORMAL | HIGH
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  lease Lease @relation(fields: [leaseId], references: [id])
  tenant User @relation("TicketTenant", fields: [tenantId], references: [id])
  updates TicketUpdate[]

  @@index([ownerId, status])
  @@index([tenantId, status])
}

model TicketUpdate {
  id          String   @id @default(cuid())
  ticketId    String
  authorId    String
  body        String
  photoUrl    String?
  statusAfter String?
  createdAt   DateTime @default(now())

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Review {
  id           String   @id @default(cuid())
  leaseId      String
  listingId    String
  authorId     String
  targetUserId String?
  rating       Int
  comment      String?
  status       String   @default("PUBLISHED") // PENDING | PUBLISHED | REJECTED
  createdAt    DateTime @default(now())

  lease   Lease   @relation(fields: [leaseId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])

  @@unique([leaseId, authorId])
  @@index([listingId])
}

model Report {
  id          String    @id @default(cuid())
  reporterId  String
  listingId   String?
  targetUserId String?
  reason      String // SCAM | FAKE | INAPPROPRIATE | DUPLICATE | OTHER
  details     String?
  status      String    @default("OPEN") // OPEN | REVIEWING | RESOLVED | DISMISSED
  resolution  String?
  reviewedById String?
  createdAt   DateTime  @default(now())

  reporter User    @relation("ReportReporter", fields: [reporterId], references: [id])
  listing  Listing? @relation(fields: [listingId], references: [id])

  @@index([status])
}

// ---------- Audit & paramétrage ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // ex. LISTING_PUBLISH, KYC_APPROVE, PAYOUT_APPROVE, SETTING_UPDATE...
  entityType String
  entityId   String?
  metaJson   String?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
}

model AdminSetting {
  key       String   @id
  valueJson String
  label     String?
  group     String? // FINANCE | AFFILIATION | MODERATION | NOTIFICATIONS
  updatedAt DateTime @updatedAt
}
