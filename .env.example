# ============================================================
# LocaBénin — Modèle de variables d'environnement
# ============================================================

# Database — Neon Serverless PostgreSQL
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-autumn-smoke-bebvdsys-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-autumn-smoke-bebvdsys.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Project & APIs
NEON_PROJECT_ID="your_neon_project_id"
NEON_BRANCH_ID="your_neon_branch_id"
NEON_API_KEY="your_neon_api_key"
NEON_API_URL="https://ep-autumn-smoke-bebvdsys.apirest.c-9.us-east-2.aws.neon.tech/neondb/rest/v1"
NEON_AUTH_URL="https://ep-autumn-smoke-bebvdsys.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth"
NEON_JWKS_URL="https://ep-autumn-smoke-bebvdsys.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# S3-compatible Storage (Neon / AWS S3)
AWS_ENDPOINT_URL_S3="https://your_storage_endpoint"
AWS_ACCESS_KEY_ID="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
AWS_REGION="us-east-2"

# Sécurité & Session
SESSION_SECRET="generate_at_least_32_characters_random_secret_here"
PAYMENT_PROVIDER="mock"
NEXT_PUBLIC_APP_NAME="LocaBénin"
